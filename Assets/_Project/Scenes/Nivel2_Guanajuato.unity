  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: de660e70b7d4c584aa5aa38a43e97e75, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BossController
  bossName: La Llorona
  introText: "Un llanto baja por los callejones. Seg\xFAn cuenta la leyenda, es La
    Llorona, pero el Ente del Olvido torci\xF3 su historia.\n\nNo hay que pelear:
    escucha de qu\xE9 lado viene y esquiva sus l\xE1grimas."
  calmedText: Al escuchar su historia completa, el llanto se vuelve silencio y La
    Llorona deja libre la puerta.
  phases:
  - name: "la lluvia de l\xE1grimas"
    storyFragment: "Cuentan que en muchos pueblos de M\xE9xico se escucha por las
      noches el llanto de una mujer junto al agua."
    spawners: []
    tearSpawners:
    - {fileID: 1046823319}
    obstacles: []
  - name: los ecos del llanto
    storyFragment: "Dicen que busca a sus hijos, y por eso recorre las calles llam\xE1ndolos:
      \xAB\xA1Ay, mis hijos!\xBB."
    spawners:
    - {fileID: 2082256345}
    tearSpawners: []
    obstacles: []
  - name: las azoteas rotas
    storyFragment: Su historia ha pasado de abuelos a nietos. Escucharla con respeto
      calma su llanto.
    spawners: []
    tearSpawners:
    - {fileID: 846637938}
    obstacles: []
  progress: {fileID: 1866984499}
  hud: {fileID: 1389906196}
  bossSprite: {fileID: 868648745}
  bossAppearedEvent: {fileID: 11400000, guid: b8bdfe3fcf5bcf849b2f107db6f1aae5, type: 2}
  phaseClearedEvent: {fileID: 11400000, guid: 36954e0586ffa2d44a0eaeadb948b9e4, type: 2}

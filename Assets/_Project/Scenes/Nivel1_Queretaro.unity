--- !u!114 &992013164
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 992013163}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: de660e70b7d4c584aa5aa38a43e97e75, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BossController
  bossName: La Zacatecana
  introText: "Una sombra con velo aparece sobre los arcos. Seg\xFAn cuenta la leyenda,
    es La Zacatecana, pero el Ente del Olvido torci\xF3 su historia.\n\nNo hay que
    pelear: cruza los tres tramos sin tocar sus obst\xE1culos."
  calmedText: "Al recordar su historia como Quer\xE9taro la cuenta, la sombra se
    calma y deja libre la puerta."
  phases:
  - name: "los murci\xE9lagos"
    storyFragment: "Cuentan que a inicios del siglo XIX una mujer llegada de Zacatecas
      vivi\xF3 con su esposo, un rico minero, en una casona del centro de Quer\xE9taro."
    spawners:
    - {fileID: 1312577637}
    tearSpawners: []
    obstacles: []
  - name: las rejas
    storyFragment: "Dicen que un d\xEDa su esposo desapareci\xF3 y que ella guard\xF3
      un secreto que nadie m\xE1s conoc\xEDa."
    spawners: []
    tearSpawners: []
    obstacles: []
  - name: las azoteas rotas
    storyFragment: "Hoy la casona es un museo y Quer\xE9taro sigue contando su leyenda.
      Recordarla le quita fuerza al olvido."
    spawners:
    - {fileID: 103740301}
    tearSpawners: []
    obstacles: []
  progress: {fileID: 1848174322}
  hud: {fileID: 1419437339}
  bossSprite: {fileID: 1723441643}
  bossAppearedEvent: {fileID: 11400000, guid: b8bdfe3fcf5bcf849b2f107db6f1aae5, type: 2}
  phaseClearedEvent: {fileID: 11400000, guid: 36954e0586ffa2d44a0eaeadb948b9e4, type: 2}

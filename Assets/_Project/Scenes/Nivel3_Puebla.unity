  m_Script: {fileID: 11500000, guid: de660e70b7d4c584aa5aa38a43e97e75, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BossController
  bossName: "Popocat\xE9petl e Iztacc\xEDhuatl"
  introText: "Las azoteas tiemblan. Son Popocat\xE9petl e Iztacc\xEDhuatl, pero el
    olvido enred\xF3 su historia y el volc\xE1n lanza rocas.\n\nNo hay que pelear:
    todo se mueve despacio. M\xEDralo y esqu\xEDvalo."
  calmedText: "Al recordar su historia completa, el volc\xE1n se calma y los dos
    vuelven a descansar."
  phases:
  - name: las rocas encendidas
    storyFragment: "Cuentan que la princesa Iztacc\xEDhuatl y el guerrero Popocat\xE9petl
      se quer\xEDan, pero \xE9l tuvo que partir a la guerra."
    spawners: []
    tearSpawners:
    - {fileID: 1733625520}
    obstacles: []
  - name: las nubes de ceniza
    storyFragment: "A ella le dijeron que \xE9l hab\xEDa muerto, y la tristeza la
      venci\xF3."
    spawners:
    - {fileID: 1741027848}
    tearSpawners: []
    obstacles: []
  - name: el temblor de las azoteas
    storyFragment: "\xC9l la llev\xF3 a la monta\xF1a y se qued\xF3 vel\xE1ndola
      con su antorcha. Desde entonces son los dos volcanes."
    spawners: []
    tearSpawners:
    - {fileID: 1672635971}
    obstacles: []
  progress: {fileID: 1021401329}
  hud: {fileID: 1353701499}
  bossSprite: {fileID: 1156505078}
  bossAppearedEvent: {fileID: 11400000, guid: b8bdfe3fcf5bcf849b2f107db6f1aae5, type: 2}
  phaseClearedEvent: {fileID: 11400000, guid: 36954e0586ffa2d44a0eaeadb948b9e4, type: 2}
